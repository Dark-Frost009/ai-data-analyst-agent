# Copy this file to `.env` and fill in values as needed.
#
# `.env` is git-ignored — never commit real credentials or secrets.
#
# --- Language model ---
LLM_PROVIDER=groq
LLM_MODEL_ID=openai/gpt-oss-20b
# Enter locally only; use Streamlit Secrets for a shared deployment.
GROQ_API_KEY=
LLM_CONNECT_TIMEOUT_SECONDS=5
LLM_READ_TIMEOUT_SECONDS=45
# --- Application ---
APP_ENV=development
LOG_LEVEL=INFO
# Required for shared deployments. Production fails closed if blank.
# For a public Streamlit Community Cloud deployment, set a strong value in the
# Cloud Secrets screen instead of committing it to this file or the repository.
APP_ACCESS_PASSWORD=
# --- Data & Query Limits ---
MAX_UPLOAD_SIZE_MB=100
MAX_DATASET_ROWS=100000
MAX_DATASET_COLUMNS=200
# Includes a conservative reservation for both raw and execution frames.
MAX_DATASET_MEMORY_MB=128
MAX_TOTAL_DATASET_MEMORY_MB=256
MAX_QUESTION_CHARS=2000
MAX_PROMPT_CHARS=48000
MAX_SAMPLE_VALUE_CHARS=256
MAX_QUERY_RESULT_ROWS=10000
QUERY_TIMEOUT_SECONDS=30
# Complete analyses allowed simultaneously in one Streamlit process.
# Keep this at 1 unless your deployment has enough memory and CPU capacity.
MAX_CONCURRENT_ANALYSES=1
# --- SQL Execution (DuckDB) Resource Limits ---
DUCKDB_MEMORY_LIMIT=512MB
DUCKDB_THREAD_LIMIT=2

# Large uploads use temporary disk storage; small uploads use pandas.
MAX_DISK_DATASET_ROWS=2000000
MAX_DATASET_DISK_MB=512
MAX_TOTAL_DATASET_DISK_MB=1024
DATASET_LOAD_TIMEOUT_SECONDS=180

# Process-wide rolling budget, includes planning and explanation requests.
MAX_LLM_REQUESTS_PER_HOUR=60
