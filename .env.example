# Copy this file to `.env` and fill in values as needed.
#
# `.env` is git-ignored — never commit real credentials or secrets.
#
# NOTE: AWS credentials are intentionally not configured here. boto3 resolves
# them through the standard AWS credential chain.
# --- AWS / Amazon Bedrock ---
AWS_REGION=ap-south-1
BEDROCK_MODEL_ID=apac.amazon.nova-lite-v1:0
# Network limits for one Bedrock request.
BEDROCK_CONNECT_TIMEOUT_SECONDS=5
BEDROCK_READ_TIMEOUT_SECONDS=45
# --- Application ---
APP_ENV=development
LOG_LEVEL=INFO
# Optional public-demo access gate. Leave blank for normal local development.
# For a public Streamlit Community Cloud deployment, set a strong value in the
# Cloud Secrets screen instead of committing it to this file or the repository.
APP_ACCESS_PASSWORD=
# --- Data & Query Limits ---
MAX_UPLOAD_SIZE_MB=200
MAX_QUERY_RESULT_ROWS=10000
QUERY_TIMEOUT_SECONDS=30
# Complete analyses allowed simultaneously in one Streamlit process.
# Keep this at 1 unless your deployment has enough memory and CPU capacity.
MAX_CONCURRENT_ANALYSES=1
# --- SQL Execution (DuckDB) Resource Limits ---
DUCKDB_MEMORY_LIMIT=512MB
DUCKDB_THREAD_LIMIT=2