# Copy this file to `.env` and fill in values as needed.
# `.env` is git-ignored — never commit real credentials or secrets.
#
# NOTE: AWS credentials (access key / secret key) are intentionally NOT
# configured here. boto3 will resolve credentials automatically via the
# standard AWS credential chain: `aws configure`, an IAM role, or the
# AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY environment variables set
# outside of this project.

# --- AWS / Amazon Bedrock ---
AWS_REGION=ap-south-1
# Amazon Nova Lite (APAC inference profile) — confirmed working via a
# live Bedrock smoke test. Many Bedrock models require an inference
# profile ID (regionally prefixed "us."/"eu."/"apac." or account-wide
# "global.") rather than the bare model ID. Check Bedrock -> Cross-region
# inference in the console if this ever needs to change.
BEDROCK_MODEL_ID=apac.amazon.nova-lite-v1:0

# --- Application ---
APP_ENV=development
LOG_LEVEL=INFO

# --- Data & Query Limits ---
MAX_UPLOAD_SIZE_MB=200
MAX_QUERY_RESULT_ROWS=10000
QUERY_TIMEOUT_SECONDS=30

# --- SQL Execution (DuckDB) Resource Limits ---
DUCKDB_MEMORY_LIMIT=512MB
DUCKDB_THREAD_LIMIT=2